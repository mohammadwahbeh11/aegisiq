# ── Environment / secrets ────────────────────────────────────────────
.env
frontend/.env
*.env.local
# Never commit real key material
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/.venv/
.venv/
venv/

# ── Databases (dev + leftovers) ──────────────────────────────────────
# The SQLite dev DB and any of its WAL/SHM sidecars or timestamped
# backups must never be committed — they hold local demo data + secrets.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/siem.db*
*.stale_*
*.bak

# ── Node / frontend build ────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
node_modules/
dist/

# ── Analysis / uploads scratch ───────────────────────────────────────
backend/uploads/
/tmp/

# ── OS / editor ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# TLS certificates (generate locally; never commit private keys)
certs/
*.key
*.crt
*.pfx

# ── Local tunnelling / deploy scratch (never belongs in the repo) ─────
# cloudflared is a ~55 MB downloaded binary; config.yml is its local
# tunnel config. Both are machine-specific and would bloat every clone.
cloudflared*
config.yml

# ── Office lock files ────────────────────────────────────────────────
# Word/PowerPoint write these while a doc is open; one was committed by
# accident and then showed up as a phantom deletion in every git status.
~$*

# ── TypeScript / Vite build artifacts ────────────────────────────────
# tsc -b writes .tsbuildinfo incremental caches, and vite.config.ts gets
# emitted as vite.config.js/.d.ts. All four are regenerated by the build
# and were previously tracked, so every `npm run build` dirtied the tree.
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
