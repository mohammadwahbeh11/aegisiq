# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

# --- Backend ---

# SQLite by default (lightweight mode). Leave unset to use the default
# absolute path <repo>/data/siem.db (resolved in app/config.py, so the
# server can be started from any working directory). To use PostgreSQL
# later, install psycopg[binary] and set e.g.:
# DATABASE_URL=postgresql+psycopg://siem:password@postgres:5432/siem
DATABASE_URL=

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default administrator account, created once on first startup if no users
# exist yet. Log in and change this password immediately.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Comma-separated list of frontend origins allowed to call the API. Add
# the machine's LAN address here if the console is opened from another
# host (e.g. http://192.168.1.20:5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173

LOG_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90
MAX_DB_SIZE_MB=500

# --- v2.3 Data-at-rest encryption (AES-256-GCM) ---
# Master secret, stretched to a 32-byte AES key with scrypt. Encrypts MFA
# secrets + backup-code hashes at rest. Leave blank in dev (the app boots
# in plaintext mode and logs a warning). Generate a strong value with:
#   openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# --- v2.3 Multi-factor authentication (TOTP, RFC 6238) ---
# MFA_ENABLED: feature on/off. MFA_REQUIRED: force every account to enrol
# (leave false so the first admin can log in and set MFA up). MFA_ISSUER:
# label shown in the authenticator app. MFA_TOTP_WINDOW: accepted drift in
# 30-second steps (1 => ±30 s, the RFC recommendation).
MFA_ENABLED=true
MFA_REQUIRED=false
MFA_ISSUER=AegisIQ
MFA_TOTP_WINDOW=1

# --- v2.1 premium license (Log Analysis Report) ---
# Blank => the premium Log Analysis feature is locked (402). Activate a
# key here or at runtime via PATCH /api/license/activate. Demo educational
# key (never expires): AEGIS-EDUC-6M9N-4W7X-C1AV
PREMIUM_LICENSE_KEY=

# --- SOAR (automated response) ---
# SOAR_ENABLED=true records a containment action for every high/critical
# alert. SOAR_EXECUTE=false means those actions are recorded and shown in
# the console but never executed against a real host -- this project ships
# no code that runs a firewall command.
SOAR_ENABLED=true
SOAR_EXECUTE=false
# v2.3: forward each recorded SOAR action to an external automation
# platform (Shuffle / Cortex / n8n / TheHive). Blank = off (record-only).
# If SOAR_WEBHOOK_SECRET is set, the POST body is HMAC-SHA256 signed in
# the X-AegisIQ-Signature header so the receiver can verify it.
SOAR_WEBHOOK_URL=
SOAR_WEBHOOK_SECRET=

# --- v2.3 Sigma rules (detections as config, not code) ---
# Drop community or custom Sigma .yml rules into this directory; they take
# effect on the next analysis. Blank default resolves to <repo>/sigma_rules.
SIGMA_ENABLED=true
# SIGMA_RULES_DIR=/absolute/path/to/sigma_rules

# --- Deployment environment ---
# ENV=production turns on the startup security guardrail: the app refuses
# to boot with the demo SECRET_KEY / admin password, a missing
# DATA_ENCRYPTION_KEY, or wildcard CORS. Leave as development for the lab.
ENV=development

# --- Optional Wazuh integration ---
# Blank => /api/integrations/wazuh/status reports "not_configured" rather
# than pretending a manager is connected.
WAZUH_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=false

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8000
# For an HTTPS/TLS backend (scripts/run_https.sh -> https://localhost:8443)
# set instead:  VITE_API_URL=https://localhost:8443
# The live alert stream (WebSocket) upgrades ws:// -> wss:// automatically.
# See docs/HTTPS.md for cert generation and the docker TLS overlay.
